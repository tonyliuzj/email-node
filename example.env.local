# Replace both values with long random strings, e.g. the output of: openssl rand -base64 32
# The app refuses to run while they are still the placeholders below.
SESSION_PASSWORD=auto_generated_during_installation
DATA_ENCRYPTION_KEY=auto_generated_during_installation

# Recommended: stops anyone else creating the admin account before you do. e.g. openssl rand -hex 16
# SETUP_TOKEN=

PORT=3000
